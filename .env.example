# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/hr_outreach_automation
NODE_ENV=development

# Google OAuth: set up Gmail API in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional AI-compatible chat completions endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Safety: leave true while testing; actual sends require configured OAuth and in-app approval
DRY_RUN=true
MAX_RESUME_MB=5
